<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Botão de Sair no canto superior esquerdo -->
    <Button
        android:id="@+id/btnSair"
        android:layout_width="70dp"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_margin="12dp"
        android:textSize="12sp"
        android:text="Sair" />

    <!-- Botão de Inventário (E) no canto superior direito -->
    <Button
        android:id="@+id/btnInventario"
        android:layout_width="70dp"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="12dp"
        android:textSize="12sp"
        android:text="Inv [E]" />

    <!-- Direcionais Touch (WASD) - Canto inferior esquerdo -->
    <RelativeLayout
        android:id="@+id/layoutDpad"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp">

        <Button
            android:id="@+id/btnW"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:text="W" />

        <Button
            android:id="@+id/btnA"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="A" />

        <Button
            android:id="@+id/btnD"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="D" />

        <Button
            android:id="@+id/btnS"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:text="S" />
    </RelativeLayout>

    <!-- Botões de Ação (Pular, Quebrar, Colocar) - Canto inferior direito -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnColocar"
            android:layout_width="90dp"
            android:layout_height="48dp"
            android:layout_marginBottom="6dp"
            android:textSize="11sp"
            android:text="Colocar (M1)" />

        <Button
            android:id="@+id/btnQuebrar"
            android:layout_width="90dp"
            android:layout_height="48dp"
            android:layout_marginBottom="6dp"
            android:textSize="11sp"
            android:text="Quebrar (M3)" />

        <Button
            android:id="@+id/btnPular"
            android:layout_width="90dp"
            android:layout_height="48dp"
            android:textSize="12sp"
            android:text="Pular" />
    </LinearLayout>

    <!-- Botões de Seleção da Hotbar [1, 2, 3] no topo central -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBloco1"
            android:layout_width="45dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:text="1" />

        <Button
            android:id="@+id/btnBloco2"
            android:layout_width="45dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:text="2" />

        <Button
            android:id="@+id/btnBloco3"
            android:layout_width="45dp"
            android:layout_height="40dp"
            android:text="3" />
    </LinearLayout>

</RelativeLayout>